# Staging environment template for Docker Compose. Copy to .env.staging and
# replace every placeholder using the deployment secret manager.
NODE_ENV=production

# Database
POSTGRES_USER=haspataal
POSTGRES_PASSWORD=YOUR_STAGING_DB_PASSWORD_HERE
POSTGRES_DB=haspataal

# Redis (must match the Redis container's requirepass setting)
REDIS_PASSWORD=YOUR_STAGING_REDIS_PASSWORD_HERE
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Secrets (minimum 32 characters enforced by code)
NEXTAUTH_SECRET=YOUR_STAGING_NEXTAUTH_SECRET_HERE
CSRF_SECRET=YOUR_STAGING_CSRF_SECRET_HERE

# Domain configuration
NEXT_PUBLIC_APP_URL=https://staging.haspataal.com
NEXT_PUBLIC_API_URL=https://staging.haspataal.com/api
