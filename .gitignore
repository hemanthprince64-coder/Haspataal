# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.staging.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dev mock DB
apps/common/*.json

graphify-out/
.kilo/
.agent/
.metagpt/
.turbo/

# Test artifacts & simulation noise
playwright-report/
test-results/
simulation_results.json
temp_transcript.txt

# SQLite / embedded DB files (never commit dev databases)
*.db
*.sqlite
*.sqlite3
dev.db
*.db-journal

# TLS / PKI artifacts (never commit certificates or private keys)
*.pem
*.key
*.crt
*.p12
*.jks

# Coverage
coverage/
lcov.info
tmp/  
downloads/  
*.log 


