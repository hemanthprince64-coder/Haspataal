{
  "apiVersion": 1,
  "type": "haspataal-operations",
  "title": "Haspataal Operations Dashboard",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "graph",
      "targets": [
        { "expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{route}}" }
      ],
      "yAxes": [{ "label": "req/s", "min": 0 }]
    },
    {
      "id": 2,
      "title": "P95 Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "P95"
        }
      ],
      "yAxes": [{ "label": "seconds", "min": 0 }]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "graph",
      "targets": [
        { "expr": "rate(http_requests_total{status_code=~\"5..\"}[5m])", "legendFormat": "5xx" }
      ],
      "yAxes": [{ "label": "errors/s", "min": 0 }]
    },
    {
      "id": 4,
      "title": "Authorization Decisions",
      "type": "graph",
      "targets": [
        { "expr": "rate(haspataal_authz_decisions_total[5m])", "legendFormat": "{{decision}}" }
      ],
      "yAxes": [{ "label": "decisions/s", "min": 0 }]
    },
    {
      "id": 5,
      "title": "Queue Depth",
      "type": "graph",
      "targets": [{ "expr": "bullmq_queue_depth", "legendFormat": "{{queue_name}}" }],
      "yAxes": [{ "label": "jobs", "min": 0 }]
    },
    {
      "id": 6,
      "title": "Consumer Lag",
      "type": "graph",
      "targets": [
        { "expr": "bullmq_consumer_lag", "legendFormat": "{{queue_name}} {{consumer_name}}" }
      ],
      "yAxes": [{ "label": "messages", "min": 0 }]
    },
    {
      "id": 7,
      "title": "DB Connection Pool",
      "type": "gauge",
      "targets": [{ "expr": "db_connection_pool_utilization", "min": 0, "max": 1 }]
    },
    {
      "id": 8,
      "title": "Outbox Events",
      "type": "graph",
      "targets": [{ "expr": "rate(outbox_events_total[5m])", "legendFormat": "{{status}}" }],
      "yAxes": [{ "label": "events/s", "min": 0 }]
    }
  ]
}
