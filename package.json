{
  "name": "haspataal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/auth",
    "services/gateway"
  ],
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          ".next/**",
          "dist/**"
        ]
      },
      "dev": {
        "cache": false,
        "persistent": true
      },
      "test": {
        "outputs": [
          "coverage/**"
        ]
      },
      "lint": {}
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=patient-portal",
    "dev:all": "turbo run dev --concurrency=20",
    "dev:patient": "turbo run dev --filter=patient-portal",
    "dev:admin": "turbo run dev --filter=haspataal-admin",
    "dev:gateway": "turbo run dev --filter=@haspataal/api-gateway",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "postinstall": "node scripts/utilities/prisma-cmd.js generate",
    "migrate": "node scripts/utilities/prisma-cmd.js migrate deploy",
    "migrate:status": "node scripts/utilities/prisma-cmd.js migrate status",
    "migrate:resolve": "node scripts/utilities/prisma-cmd.js migrate resolve",
    "db:push": "node scripts/utilities/prisma-cmd.js db push",
    "start": "next start",
    "lint": "eslint",
    "lint:all": "turbo run lint",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "worker:notify": "npx ts-node --project workers/tsconfig.json workers/notification-worker.ts",
    "worker:rules": "npx ts-node --project workers/tsconfig.json workers/rules-worker.ts",
    "audit": "npx tsx scripts/quality-audit.ts",
    "events:replay": "npx tsx scripts/replay-events.ts",
    "clean": "turbo run clean && Remove-Item -Recurse -Force .next, apps/**/.next, packages/**/dist -ErrorAction SilentlyContinue"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "prisma/schema.prisma": [
      "npx prisma validate",
      "npx prisma format"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "0.24.1",
    "@prisma/client": "5.10.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/supabase-js": "2.98.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.76.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "ioredis": "5.10.1",
    "jose": "6.1.3",
    "lucide-react": "1.8.0",
    "next": "15.5.7",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prom-client": "^15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.73.1",
    "sonner": "2.0.7",
    "swr": "2.4.1",
    "tailwind-merge": "3.5.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@next/bundle-analyzer": "16.2.11",
    "@playwright/test": "^1.59.1",
    "@testcontainers/postgresql": "11.14.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.6",
    "@types/ioredis-mock": "8.2.7",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "4.1.5",
    "autoprefixer": "10.4.27",
    "chalk": "^4.1.2",
    "dotenv": "17.3.1",
    "eslint": "9",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-local-rules": "^3.0.2",
    "husky": "9.1.7",
    "ioredis-mock": "8.13.1",
    "lint-staged": "16.4.0",
    "pg": "8.20.0",
    "postcss": "8.5.14",
    "prettier": "3.8.3",
    "prisma": "5.10.2",
    "tailwindcss": "3.4.19",
    "testcontainers": "11.14.0",
    "turbo": "2.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14"
    },
    "bullmq": {
      "uuid": "14.0.0"
    },
    "testcontainers": {
      "uuid": "14.0.0"
    }
  }
}
