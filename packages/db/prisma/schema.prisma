  patientId           String          @map("patient_id")
  bedId               String?         @map("bed_id")
  attendingDoctorId   String?         @map("attending_doctor_id")
  admissionNumber     String          @map("admission_number")
  status              AdmissionStatus @default(ADMITTED)
  reason              String?
  admittedAt          DateTime        @default(now()) @map("admitted_at")
  expectedDischargeAt DateTime?       @map("expected_discharge_at")
  dischargedAt        DateTime?       @map("discharged_at")
  dischargeSummary    String?         @map("discharge_summary")
  dailyBedCharge      Decimal?        @map("daily_bed_charge")
  payload             Json?           @default("{}")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  acuity                        PatientAcuity                  @default(STABLE)
  acuityUpdatedAt               DateTime?                      @default(now()) @map("acuity_updated_at")
  dischargeProcessStatus        DischargeProcessStatus?        @map("discharge_process_status")
  physicalPresenceStatus        PhysicalPresenceStatus?        @map("physical_presence_status")
  legacyDepartureClassification LegacyDepartureClassification? @map("legacy_departure_classification")

  lamaEpisodes    LamaEpisode[]
  absenceEpisodes AbsenceEpisode[]
  departureRecord PhysicalDepartureRecord?

  hospital        HospitalsMaster @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
