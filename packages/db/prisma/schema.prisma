  criticalMax   Float?  @map("critical_max")
  displayOrder  Int     @default(0) @map("display_order")
  decimalPlaces Int     @default(2) @map("decimal_places")

  template     TestTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  resultValues LabResultValue[]

  @@index([templateId])
  @@map("test_template_parameters")
}

