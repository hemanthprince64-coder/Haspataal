  IPD
  EMERGENCY
  TELECONSULTATION
  HOME_VISIT
  DAYCARE
  FOLLOW_UP
}

enum EncounterStatus {
  ACTIVE
  TRIAGE
  CONSULTATION
  COMPLETED
  CANCELLED
}

model Encounter {
  id            String          @id @default(uuid())
  patientId     String          @map("patient_id")
  hospitalId    String          @map("hospital_id")
  appointmentId String?         @map("appointment_id")
  doctorId      String?         @map("doctor_id")
  departmentId  String?         @map("department_id")
  locationId    String?         @map("location_id")
  encounterType EncounterType   @map("encounter_type")
  status        EncounterStatus @default(ACTIVE)
  startedAt     DateTime        @default(now()) @map("started_at")
  endedAt       DateTime?       @map("ended_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital    HospitalsMaster     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment Appointment?        @relation(fields: [appointmentId], references: [id])
  doctor      DoctorMaster?       @relation(fields: [doctorId], references: [id])
  department  HospitalDepartment? @relation(fields: [departmentId], references: [id])

  orders              ClinicalOrder[]
