  createdAt  DateTime @default(now()) @map("created_at")

  hospital    HospitalsMaster     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient     Patient             @relation(fields: [patientId], references: [id])
  intent      PaymentIntent       @relation(fields: [intentId], references: [id])
  allocations PaymentAllocation[]

  @@unique([hospitalId, gatewayTransactionId])
  @@index([hospitalId, status])
  @@index([intentId])
  @@map("payments")
