  status        ReceiptStatus @default(ISSUED)
  snapshot      Json // Immutable copy of patient/hospital/payment at issuance time
  voidReason    String?       @map("void_reason")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hospital     HospitalsMaster @relation(fields: [hospitalId], references: [id])
  patient      Patient         @relation(fields: [patientId], references: [id])
  lines        ReceiptLine[]
  AuthMethod   AuthMethod?     @relation(fields: [authMethodId], references: [id])
  authMethodId String?

  @@unique([hospitalId, receiptNumber])
}

model ReceiptLine {
  id           String  @id @default(uuid())
  receiptId    String  @map("receipt_id")
  allocationId String  @unique @map("allocation_id") // 1:1 with PaymentAllocation
  invoiceId    String  @map("invoice_id")
  amount       Decimal

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  receipt    Receipt           @relation(fields: [receiptId], references: [id])
  allocation PaymentAllocation @relation(fields: [allocationId], references: [id])
  invoice    Invoice           @relation(fields: [invoiceId], references: [id])
}

model PaymentReconciliation {
  id         String   @id @default(uuid())
  hospitalId String   @map("hospital_id")
  createdAt  DateTime @default(now()) @map("created_at")
}
