  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  versionNumber   Int           @map("version_number")
  status          OrderStatus   @default(REQUESTED)
  priority        OrderPriority @default(ROUTINE)
  clinicalNotes   String?       @map("clinical_notes")
  reasonForChange String?       @map("reason_for_change")
  createdBy       String        @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  order     Order  @relation(fields: [orderId], references: [id])
  activeFor Order? @relation(name: "ActiveVersion")

  @@unique([orderId, versionNumber])
  @@map("order_versions")
}

model OrderItem {
  id                  String      @id @default(uuid())
  orderId             String      @map("order_id")
  catalogVersionId    String      @map("catalog_version_id")
  departmentId        String?     @map("department_id") // Receiving department
  status              OrderStatus @default(REQUESTED)
  quantity            Int         @default(1)
  schedule            Json? // Standing orders: frequency, duration, condition
  clinicalNotes       String?     @map("clinical_notes")
  externalSystem      String?     @map("external_system")
  externalReferenceId String?     @map("external_reference_id")
  syncStatus          String?     @map("sync_status")
  lastSyncAt          DateTime?   @map("last_sync_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  order          Order                       @relation(fields: [orderId], references: [id])
  catalogVersion ClinicalOrderCatalogVersion @relation(fields: [catalogVersionId], references: [id])

  dependenciesAsSource OrderDependency[] @relation("SourceDependency")
  dependenciesAsTarget OrderDependency[] @relation("TargetDependency")

  pharmacyExecutionItem   PharmacyExecutionItem?
  marAttempts             MedicationAdministrationAttempt[]
  LaboratoryExecutionItem LaboratoryExecutionItem?
  radiologyExecutionItem  RadiologyExecutionItem?
  ProcedureExecutionItem  ProcedureExecutionItem?
  BloodBankExecutionItem  BloodBankExecutionItem?
  referralItem            ReferralExecutionItem?

  @@index([orderId])
  @@index([departmentId])
  @@map("order_items")
}

model OrderDependency {
  id             String   @id @default(uuid())
  sourceItemId   String   @map("source_item_id")
  targetItemId   String   @map("target_item_id")
  dependencyType String // e.g., "BEFORE", "AFTER"
  createdAt      DateTime @default(now()) @map("created_at")

  sourceItem OrderItem @relation("SourceDependency", fields: [sourceItemId], references: [id])
  targetItem OrderItem @relation("TargetDependency", fields: [targetItemId], references: [id])

  @@unique([sourceItemId, targetItemId])
  @@map("order_dependencies")
}

model OrderExecution {
  id           String   @id @default(uuid())
  orderId      String   @map("order_id")
  itemId       String?  @map("item_id")
  status       String // Operational status e.g., "COLLECTED", "DISPENSED"
  performedBy  String   @map("performed_by")
  departmentId String   @map("department_id")
  metadata     Json     @default("{}") // e.g., analyzer machine ID
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([departmentId])
  @@map("order_executions")
}

model OrderCancellation {
  id          String   @id @default(uuid())
  orderId     String   @unique @map("order_id")
  reason      String
  cancelledBy String   @map("cancelled_by")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_cancellations")
}

model OrderAudit {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  action    String
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  metadata  Json     @default("{}") // Capture overrides, old states, etc.
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_audits")
}

// ==========================================
// Phase 5B.1: Pharmacy Execution Engine
// ==========================================

enum PharmacyExecutionStatus {
  PENDING_VERIFICATION
  VERIFIED
  STOCK_RESERVED
  PARTIALLY_DISPENSED
  FULLY_DISPENSED
  COMPLETED
  CANCELLED
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum InventoryBatchStatus {
  ACTIVE
  RECALLED
  DEPLETED
  EXPIRED
}

enum InventoryTransactionType {
  RESERVE
  UNRESERVE
  DISPENSE
  RETURN
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  EXPIRED
  DAMAGED
  DESTROYED
}

enum MARAttemptStatus {
  ADMINISTERED
  REFUSED
  MISSED
  OMITTED
}

// ------------------------------------------
// Pharmacy Verification & Execution
// ------------------------------------------

model PharmacyExecution {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  patientId  String @map("patient_id")

  clinicalOrderId String?        @unique @map("clinical_order_id")
  clinicalOrder   ClinicalOrder? @relation(fields: [clinicalOrderId], references: [id])

  status String @default("PRESCRIBED")

  version     Int       @default(1)
  verifiedBy  String?   @map("verified_by")
  dispensedBy String?   @map("dispensed_by")
  verifiedAt  DateTime? @map("verified_at")
  dispensedAt DateTime? @map("dispensed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items         PharmacyExecutionItem[]
  verifications PharmacyVerification[]
  dispenses     PharmacyExecutionDispense[]

  @@index([hospitalId, patientId])
  @@map("pharmacy_executions")
}

model PharmacyVerification {
  id          String            @id @default(uuid())
  executionId String            @map("execution_id")
  execution   PharmacyExecution @relation(fields: [executionId], references: [id])

  verifiedBy String   @map("verified_by")
  verifiedAt DateTime @default(now()) @map("verified_at")
  reason     String?
  override   Boolean  @default(false)
  notes      String?

  @@map("pharmacy_verifications")
}

model PharmacyExecutionItem {
  id          String            @id @default(uuid())
  executionId String            @map("execution_id")
  execution   PharmacyExecution @relation(fields: [executionId], references: [id])

  orderItemId String    @unique @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  prescribedQuantity Int       @map("prescribed_quantity")
  dispensedQuantity  Int       @default(0) @map("dispensed_quantity")
  version            Int       @default(1)
  verifiedBy         String?   @map("verified_by")
  dispensedBy        String?   @map("dispensed_by")
  verifiedAt         DateTime? @map("verified_at")
  dispensedAt        DateTime? @map("dispensed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  substitutions PharmacySubstitution[]
  reservations  StockReservation[]
  dispenseItems PharmacyExecutionDispenseItem[]

  @@map("pharmacy_execution_items")
}

model PharmacySubstitution {
  id              String                @id @default(uuid())
  executionItemId String                @map("execution_item_id")
  executionItem   PharmacyExecutionItem @relation(fields: [executionItemId], references: [id])

  substitutedCatalogVersionId String                      @map("substituted_catalog_version_id")
  substitutedCatalogVersion   ClinicalOrderCatalogVersion @relation(fields: [substitutedCatalogVersionId], references: [id])

  reason     String
  approvedBy String   @map("approved_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("pharmacy_substitutions")
}

// ------------------------------------------
// Operational Inventory
// ------------------------------------------

model InventoryItem {
  id               String                      @id @default(uuid())
  hospitalId       String                      @map("hospital_id")
  catalogVersionId String                      @map("catalog_version_id")
  catalogVersion   ClinicalOrderCatalogVersion @relation(fields: [catalogVersionId], references: [id])

  batches InventoryBatch[]

  @@unique([hospitalId, catalogVersionId])
  @@map("inventory_items")
}

model InventoryBatch {
  id              String        @id @default(uuid())
  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  batchNumber   String               @map("batch_number")
  expiryDate    DateTime             @map("expiry_date")
  physicalStock Int                  @map("physical_stock")
  reservedStock Int                  @default(0) @map("reserved_stock")
  status        InventoryBatchStatus @default(ACTIVE)

  reservations StockReservation[]
  transactions InventoryTransaction[]

  @@unique([inventoryItemId, batchNumber])
  @@map("inventory_batches")
}

model InventoryTransaction {
  id String @id @default(uuid())

  batchId String         @map("batch_id")
  batch   InventoryBatch @relation(fields: [batchId], references: [id])

  type         InventoryTransactionType
  quantity     Int
  balanceAfter Int                      @map("balance_after") // Always represents physicalStock after transaction

  referenceType String? @map("reference_type") // e.g., 'RESERVATION', 'DISPENSE', 'ADJUSTMENT'
  referenceId   String? @map("reference_id")

  actorId       String   @map("actor_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  correlationId String?  @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([batchId])
  @@index([occurredAt])
  @@map("inventory_transactions")
}

model StockReservation {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")

  batchId String         @map("batch_id")
  batch   InventoryBatch @relation(fields: [batchId], references: [id])

  executionItemId String                @map("execution_item_id")
  executionItem   PharmacyExecutionItem @relation(fields: [executionItemId], references: [id])

  quantity Int
  status   StockReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  dispenseItems PharmacyExecutionDispenseItem[]

  @@map("stock_reservations")
}

// ------------------------------------------
// Dispensing
// ------------------------------------------

model PharmacyExecutionDispense {
  id          String            @id @default(uuid())
  executionId String            @map("execution_id")
  execution   PharmacyExecution @relation(fields: [executionId], references: [id])

  dispensedAt   DateTime @default(now()) @map("dispensed_at")
  dispensedById String   @map("dispensed_by_id")

  items PharmacyExecutionDispenseItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pharmacy_execution_dispenses")
}

model PharmacyExecutionDispenseItem {
  id         String                    @id @default(uuid())
  dispenseId String                    @map("dispense_id")
  dispense   PharmacyExecutionDispense @relation(fields: [dispenseId], references: [id])

  executionItemId String                @map("execution_item_id")
  executionItem   PharmacyExecutionItem @relation(fields: [executionItemId], references: [id])

  reservationId String?           @map("reservation_id")
  reservation   StockReservation? @relation(fields: [reservationId], references: [id])

  quantityDispensed Int @map("quantity_dispensed")

  marAttempts MedicationAdministrationAttempt[]

  @@map("pharmacy_execution_dispense_items")
}

// ------------------------------------------
// Administration
// ------------------------------------------

model MedicationAdministrationAttempt {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  patientId  String @map("patient_id")

  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  dispenseItemId String?                        @map("dispense_item_id")
  dispenseItem   PharmacyExecutionDispenseItem? @relation(fields: [dispenseItemId], references: [id])

  scheduledFor  DateTime?        @map("scheduled_for")
  status        MARAttemptStatus @default(ADMINISTERED)
  attemptedAt   DateTime         @default(now()) @map("attempted_at")
  attemptedById String           @map("attempted_by_id")
  clinicalNotes String?          @map("clinical_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hospitalId, patientId])
  @@index([orderItemId])
  @@map("medication_administration_attempts")
}

// ------------------------------------------
// Laboratory Execution Engine
// ------------------------------------------

enum LaboratoryExecutionStatus {
  PENDING_COLLECTION
  COLLECTION_IN_PROGRESS
  COLLECTED
  RECEIVED
  IN_ANALYZER_QUEUE
  ANALYZING
  RESULT_ENTERED
  RESULT_VERIFIED
  RELEASED
  CANCELLED
}

enum SpecimenType {
  BLOOD
  SERUM
  PLASMA
  URINE
  STOOL
  CSF
  SPUTUM
  SWAB
  TISSUE
  OTHER
}

enum SpecimenStatus {
  EXPECTED
  COLLECTED
  RECEIVED
  REJECTED
  LOST
  EXPIRED
}

enum ResultStatus {
  DRAFT
  VERIFIED
  RELEASED
  AMENDED
}

enum SpecimenRejectionReason {
  HEMOLYZED
  CLOTTED
  INSUFFICIENT
  WRONG_CONTAINER
  LABEL_MISMATCH
  EXPIRED
  OTHER
}

model LaboratoryExecution {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  patientId  String @map("patient_id")

  clinicalOrderId String?        @unique @map("clinical_order_id")
  clinicalOrder   ClinicalOrder? @relation(fields: [clinicalOrderId], references: [id])

  orderVersionId String @map("order_version_id")

  status LaboratoryExecutionStatus @default(PENDING_COLLECTION)

  items LaboratoryExecutionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hospitalId, patientId])
  @@index([status])
  @@map("laboratory_executions")
}

model LaboratoryExecutionItem {
  id          String              @id @default(uuid())
  executionId String              @map("execution_id")
  execution   LaboratoryExecution @relation(fields: [executionId], references: [id])

  orderItemId String    @unique @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  specimenId String?   @map("specimen_id")
  specimen   Specimen? @relation(fields: [specimenId], references: [id])

  resultId String?           @map("result_id")
  result   LaboratoryResult? @relation(fields: [resultId], references: [id])

  status LaboratoryExecutionStatus @default(PENDING_COLLECTION)

  queueEntries AnalyzerQueue[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("laboratory_execution_items")
}

model Specimen {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  patientId  String @map("patient_id")

  barcode      String       @unique
  specimenType SpecimenType @map("specimen_type")

  status SpecimenStatus @default(EXPECTED)

  collectionTime DateTime? @map("collection_time")
  collectorId    String?   @map("collector_id")

  executionItems LaboratoryExecutionItem[]
  attempts       SpecimenCollectionAttempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hospitalId, patientId])
  @@map("specimens")
}

model SpecimenCollectionAttempt {
  id         String   @id @default(uuid())
  specimenId String   @map("specimen_id")
  specimen   Specimen @relation(fields: [specimenId], references: [id])

  status        SpecimenStatus
  attemptedAt   DateTime       @default(now()) @map("attempted_at")
  attemptedById String         @map("attempted_by_id")

  rejectionReason SpecimenRejectionReason? @map("rejection_reason")
  notes           String?

  @@map("specimen_collection_attempts")
}

model AnalyzerQueue {
  id              String                  @id @default(uuid())
  executionItemId String                  @map("execution_item_id")
  executionItem   LaboratoryExecutionItem @relation(fields: [executionItemId], references: [id])

  analyzerId    String?         @map("analyzer_id")
  analyzer      AnalyzerDevice? @relation(fields: [analyzerId], references: [id])
  priority      Int             @default(0) // Higher number = higher priority
  queuePosition Int             @default(0) @map("queue_position")

  status  LaboratoryExecutionStatus @default(IN_ANALYZER_QUEUE)
  retries Int                       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([analyzerId, priority])
  @@map("analyzer_queues")
}

model AnalyzerDevice {
  id         String  @id @default(uuid())
  hospitalId String  @map("hospital_id")
  name       String
  model      String?
  vendor     String?
  status     String  @default("ACTIVE")

  queues AnalyzerQueue[]

  @@map("analyzer_devices")
}

model LaboratoryResult {
  id              String @id @default(uuid())
  executionItemId String @unique @map("execution_item_id")

  hospitalId String @map("hospital_id")
  patientId  String @map("patient_id")

  status          ResultStatus @default(DRAFT)
  activeVersionId String?      @map("active_version_id")

  versions       LaboratoryResultVersion[]
  executionItems LaboratoryExecutionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hospitalId, patientId])
  @@map("laboratory_results")
}

model LaboratoryResultVersion {
  id       String           @id @default(uuid())
  resultId String           @map("result_id")
  result   LaboratoryResult @relation(fields: [resultId], references: [id])

  versionNumber Int @map("version_number")

  values            Json // Measured values
  referenceRanges   Json? @map("reference_ranges")
  abnormalFlags     Json? @map("abnormal_flags")
  units             Json?
  flags             Json?
  instrumentFlags   Json? @map("instrument_flags")
  verificationNotes Json? @map("verification_notes")
  comments          Json?

  verifiedAt DateTime? @map("verified_at")
  verifiedBy String?   @map("verified_by")

  releasedAt DateTime? @map("released_at")
  releasedBy String?   @map("released_by")

  createdAt DateTime @default(now()) @map("created_at")

  notifications CriticalValueNotification[]

  @@unique([resultId, versionNumber])
  @@map("laboratory_result_versions")
}

model CriticalValueRule {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  testCode   String @map("test_code")

  condition      String // e.g. ">", "<", "=", "BETWEEN"
  threshold      Float?
  upperThreshold Float? @map("upper_threshold")

  severity String // e.g. "CRITICAL", "ABNORMAL"

  @@map("critical_value_rules")
}

model CriticalValueNotification {
  id              String                  @id @default(uuid())
  resultVersionId String                  @map("result_version_id")
  resultVersion   LaboratoryResultVersion @relation(fields: [resultVersionId], references: [id])

  recipientId String @map("recipient_id")

  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")

  escalated Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("critical_value_notifications")
}

// ==========================================
// Phase 5B.3: Radiology Execution Engine
// ==========================================

enum RadiologyExecutionStatus {
  PENDING_SCHEDULING
  SCHEDULED
  ARRIVED
  ACQUIRING
  ACQUIRED
  REPORTING
  REPORT_VERIFIED
  RELEASED
  CANCELLED
}

enum RadiologyReportStatus {
  DRAFT
  PRELIMINARY
  FINAL
  AMENDED
}

enum ModalityType {
  XRAY
  CT
  MRI
  US
  PET
  NM
  FLORO
}

enum ContrastType {
  IODINE
  BARIUM
  GADOLINIUM
  MICROBUBBLES
  NONE
}

model RadiologyExecution {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  patientId  String @map("patient_id")

  clinicalOrderId String?        @unique @map("clinical_order_id")
  clinicalOrder   ClinicalOrder? @relation(fields: [clinicalOrderId], references: [id])

  status RadiologyExecutionStatus @default(PENDING_SCHEDULING)

  appointmentId String?               @map("appointment_id")
  appointment   RadiologyAppointment? @relation(fields: [appointmentId], references: [id])

  items    RadiologyExecutionItem[]
  sessions AcquisitionSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([hospitalId, patientId])
  @@map("radiology_executions")
}

model RadiologyExecutionItem {
  id          String             @id @default(uuid())
  executionId String             @map("execution_id")
  execution   RadiologyExecution @relation(fields: [executionId], references: [id])

  orderItemId String    @unique @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  status RadiologyExecutionStatus @default(PENDING_SCHEDULING)

  modality ModalityType

  report                 RadiologyReport?
  contrastAdministration ContrastAdministration?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([executionId])
  @@map("radiology_execution_items")
}

model RadiologyAppointment {
  id         String   @id @default(uuid())
  hospitalId String   @map("hospital_id")
  patientId  String   @map("patient_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")

  modalityId String         @map("modality_id")
  modality   ModalityDevice @relation(fields: [modalityId], references: [id])

  status RadiologyExecutionStatus @default(SCHEDULED) // Reusing status for simplicity

  executions RadiologyExecution[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([modalityId, startTime, endTime])
  @@map("radiology_appointments")
}

model ModalityDevice {
  id         String @id @default(uuid())
  hospitalId String @map("hospital_id")
  name       String

  modality      ModalityType
  status        String       @default("ACTIVE") // ACTIVE, MAINTENANCE, OFFLINE
  location      String?
  manufacturer  String?
  model         String?
  aeTitle       String?      @map("ae_title")
  supportsDicom Boolean      @default(true) @map("supports_dicom")

  appointments RadiologyAppointment[]
  sessions     AcquisitionSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("modality_devices")
}

model AcquisitionSession {
  id String @id @default(uuid())

  executionId String             @map("execution_id")
  execution   RadiologyExecution @relation(fields: [executionId], references: [id])

  modalityId String         @map("modality_id")
  modality   ModalityDevice @relation(fields: [modalityId], references: [id])

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED, REPEATED

  studies ImagingStudy[]

  @@index([executionId])
  @@map("radiology_acquisition_sessions")
}

model ImagingStudy {
  id               String  @id @default(uuid())
  studyInstanceUID String? @unique @map("study_instance_uid") // DICOM
  accessionNumber  String  @unique @map("accession_number")

  clinicalOrderId String? @map("clinical_order_id")
  encounterId     String? @map("encounter_id")
  patientId       String? @map("patient_id")
  hospitalId      String? @map("hospital_id")

  sessionId String?             @map("session_id")
  session   AcquisitionSession? @relation(fields: [sessionId], references: [id])

  dicomStudyDate String? @map("dicom_study_date")
  dicomStudyTime String? @map("dicom_study_time")

  seriesCount Int?      @map("series_count")
  imageCount  Int?      @map("image_count")
  modality    String?
  status      String?
  scheduledAt DateTime? @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  scheduledBy   String? @map("scheduled_by")
  accessionedBy String? @map("accessioned_by")
  acquiredBy    String? @map("acquired_by")

  series  ImagingSeries[]
  reports RadiologyReport[]

  clinicalOrder ClinicalOrder?   @relation(fields: [clinicalOrderId], references: [id], onDelete: Cascade)
  encounter     Encounter?       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient       Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital      HospitalsMaster? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clinicalOrderId])
  @@index([encounterId])
  @@index([patientId, createdAt])
  @@index([hospitalId, status])
  @@index([accessionNumber])
  @@index([studyInstanceUID])
  @@index([modality, status])
  @@map("imaging_studies")
}

model ImagingSeries {
  id                String       @id @default(uuid())
  seriesInstanceUID String       @unique @map("series_instance_uid") // DICOM
  studyId           String       @map("study_id")
  study             ImagingStudy @relation(fields: [studyId], references: [id])

  seriesNumber Int          @map("series_number")
  modality     ModalityType

  instances ImagingInstance[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("imaging_series")
}

model ImagingInstance {
  id             String        @id @default(uuid())
  sopInstanceUID String        @unique @map("sop_instance_uid") // DICOM
  seriesId       String        @map("series_id")
  series         ImagingSeries @relation(fields: [seriesId], references: [id])

  instanceNumber Int     @map("instance_number")
  storageUri     String  @map("storage_uri")
  mimeType       String  @map("mime_type")
  checksum       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("imaging_instances")
}

model ContrastAdministration {
  id              String                 @id @default(uuid())
  executionItemId String                 @unique @map("execution_item_id")
  executionItem   RadiologyExecutionItem @relation(fields: [executionItemId], references: [id])

  contrastType     ContrastType @map("contrast_type")
  agentName        String       @map("agent_name")
  lotNumber        String?      @map("lot_number")
  dose             Float
  unit             String
  route            String
  startedAt        DateTime     @map("started_at")
  completedAt      DateTime?    @map("completed_at")
  reactionObserved Boolean      @default(false) @map("reaction_observed")
  reactionSeverity String?      @map("reaction_severity")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("contrast_administrations")
}

model RadiologyReport {
  id String @id @default(uuid())

  executionItemId String?                 @unique @map("execution_item_id")
  executionItem   RadiologyExecutionItem? @relation(fields: [executionItemId], references: [id])

  studyId String?       @map("study_id")
  study   ImagingStudy? @relation(fields: [studyId], references: [id], onDelete: Cascade)

  status String @default("DRAFT")

  clinicalHistory String? @map("clinical_history")
  findings        String?
  impression      String?
  recommendation  String?

  reportedBy String?   @map("reported_by")
  verifiedBy String?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")

  activeVersionId String?                 @unique @map("active_version_id")
  activeVersion   RadiologyReportVersion? @relation(name: "ActiveReportVersion", fields: [activeVersionId], references: [id])

  versions         RadiologyReportVersion[]
  criticalFindings RadiologyCriticalFinding[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([executionItemId])
  @@index([studyId])
  @@map("radiology_reports")
}

model RadiologyReportVersion {
  id String @id @default(uuid())

  reportId String          @map("report_id")
  report   RadiologyReport @relation(fields: [reportId], references: [id])

  versionNumber Int    @map("version_number")
  text          String @db.Text
  enteredBy     String @map("entered_by")

  verifiedBy String?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  activeFor RadiologyReport? @relation(name: "ActiveReportVersion")

  @@unique([reportId, versionNumber])
  @@map("radiology_report_versions")
}

model RadiologyCriticalFinding {
  id String @id @default(uuid())

  reportId String          @map("report_id")
  report   RadiologyReport @relation(fields: [reportId], references: [id])

  finding             String
  severity            String
  notifiedDoctor      String?   @map("notified_doctor")
  notifiedNurse       String?   @map("notified_nurse")
  acknowledgedBy      String?   @map("acknowledged_by")
  acknowledgedAt      DateTime? @map("acknowledged_at")
  communicationLog    String?   @map("communication_log") @db.Text
  communicationMethod String?   @map("communication_method")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("radiology_critical_findings")
}

// PHASE 5B.4: PROCEDURE EXECUTION ENGINE
// ==========================================

enum ProcedureExecutionStatus {
  PENDING
  SCHEDULED
  PRE_OP
  IN_PROGRESS
  RECOVERY
  COMPLETED
  CANCELLED
}

enum ProcedurePriority {
  ELECTIVE
  URGENT
  EMERGENCY
}

enum ProcedureRoomStatus {
  AVAILABLE
  IN_USE
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum ProcedureChecklistStatus {
  PENDING
  SIGN_IN_COMPLETE
  TIME_OUT_COMPLETE
  SIGN_OUT_COMPLETE
}

enum ProcedureOutcome {
  SUCCESS
  PARTIAL_SUCCESS
  ABORTED
  COMPLICATION
  DEATH
}

enum AnesthesiaType {
  LOCAL
  REGIONAL
  GENERAL
  SEDATION
  NONE
}

enum ProcedureCancellationReason {
  PATIENT_REFUSAL
  MEDICAL_CONTRAINDICATION
  EQUIPMENT_FAILURE
  STAFF_UNAVAILABLE
  EMERGENCY_PREEMPTION
  NO_SHOW
  OTHER
}

model ProcedureExecution {
  id         String                   @id @default(uuid())
  hospitalId String                   @map("hospital_id")
  patientId  String                   @map("patient_id")
  orderId    String                   @unique @map("order_id")
  status     ProcedureExecutionStatus @default(PENDING)
  priority   ProcedurePriority        @default(ELECTIVE)
  surgeonId  String?                  @map("surgeon_id")
  roomId     String?                  @map("room_id")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  order       Order                    @relation(fields: [orderId], references: [id])
  hospital    HospitalsMaster          @relation(fields: [hospitalId], references: [id])
  patient     Patient                  @relation(fields: [patientId], references: [id])
  items       ProcedureExecutionItem[]
  appointment ProcedureAppointment?
  session     ProcedureSession?
  report      ProcedureReport?

  @@map("procedure_execution")
}

model ProcedureExecutionItem {
  id               String                   @id @default(uuid())
  executionId      String                   @map("execution_id")
  orderItemId      String                   @unique @map("order_item_id")
  catalogVersionId String                   @map("catalog_version_id")
  status           ProcedureExecutionStatus @default(PENDING)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  execution      ProcedureExecution          @relation(fields: [executionId], references: [id])
  orderItem      OrderItem                   @relation(fields: [orderItemId], references: [id])
  catalogVersion ClinicalOrderCatalogVersion @relation(fields: [catalogVersionId], references: [id])

  @@map("procedure_execution_item")
}

model ProcedureAppointment {
  id                 String            @id @default(uuid())
  executionId        String            @unique @map("execution_id")
  roomId             String            @map("room_id")
  scheduledStartTime DateTime          @map("scheduled_start_time")
  scheduledEndTime   DateTime          @map("scheduled_end_time")
  status             AppointmentStatus @default(BOOKED)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  execution ProcedureExecution @relation(fields: [executionId], references: [id])
  room      ProcedureRoom      @relation(fields: [roomId], references: [id])

  @@map("procedure_appointment")
}

model ProcedureRoom {
  id         String              @id @default(uuid())
  hospitalId String              @map("hospital_id")
  name       String
  roomType   String              @map("room_type") // OT, CATH_LAB, ENDOSCOPY
  status     ProcedureRoomStatus @default(AVAILABLE)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  hospital     HospitalsMaster        @relation(fields: [hospitalId], references: [id])
  appointments ProcedureAppointment[]
  sessions     ProcedureSession[]

  @@map("procedure_room")
}

model ProcedureSession {
  id                 String                       @id @default(uuid())
  executionId        String                       @unique @map("execution_id")
  roomId             String                       @map("room_id")
  patientEnteredAt   DateTime?                    @map("patient_entered_at")
  procedureStartedAt DateTime?                    @map("procedure_started_at")
  procedureEndedAt   DateTime?                    @map("procedure_ended_at")
  patientExitedAt    DateTime?                    @map("patient_exited_at")
  outcome            ProcedureOutcome?
  cancellationReason ProcedureCancellationReason? @map("cancellation_reason")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  execution  ProcedureExecution          @relation(fields: [executionId], references: [id])
  room       ProcedureRoom               @relation(fields: [roomId], references: [id])
  checklist  ProcedureChecklist?
  anesthesia AnesthesiaEpisode?
  implants   ImplantUsage[]
  incidents  ProcedureCriticalIncident[]

  @@map("procedure_session")
}

model ProcedureChecklist {
  id        String                   @id @default(uuid())
  sessionId String                   @unique @map("session_id")
  status    ProcedureChecklistStatus @default(PENDING)
  signInAt  DateTime?                @map("sign_in_at")
  signInBy  String?                  @map("sign_in_by")
  timeOutAt DateTime?                @map("time_out_at")
  timeOutBy String?                  @map("time_out_by")
  signOutAt DateTime?                @map("sign_out_at")
  signOutBy String?                  @map("sign_out_by")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  session ProcedureSession @relation(fields: [sessionId], references: [id])

  @@map("procedure_checklist")
}

model AnesthesiaEpisode {
  id             String         @id @default(uuid())
  sessionId      String         @unique @map("session_id")
  anesthesiaType AnesthesiaType @map("anesthesia_type")
  anesthetistId  String         @map("anesthetist_id")
  inductionAt    DateTime?      @map("induction_at")
  emergenceAt    DateTime?      @map("emergence_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  session ProcedureSession @relation(fields: [sessionId], references: [id])

  @@map("anesthesia_episode")
}

model ImplantUsage {
  id           String   @id @default(uuid())
  sessionId    String   @map("session_id")
  implantName  String   @map("implant_name")
  serialNumber String?  @map("serial_number")
  lotNumber    String?  @map("lot_number")
  manufacturer String?  @map("manufacturer")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session ProcedureSession @relation(fields: [sessionId], references: [id])

  @@map("implant_usage")
}

model ProcedureReport {
  id              String   @id @default(uuid())
  executionId     String   @unique @map("execution_id")
  status          String   @default("DRAFT") // DRAFT, FINAL, AMENDED
  activeVersionId String?  @unique @map("active_version_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  execution     ProcedureExecution       @relation(fields: [executionId], references: [id])
  activeVersion ProcedureReportVersion?  @relation("ProcedureReportActiveVersion", fields: [activeVersionId], references: [id])
  versions      ProcedureReportVersion[] @relation("ProcedureReportVersions")

  @@map("procedure_report")
}

model ProcedureReportVersion {
  id            String   @id @default(uuid())
  reportId      String   @map("report_id")
  versionNumber Int      @map("version_number")
  text          String
  reason        String?
  authorId      String   @map("author_id")
  createdAt     DateTime @default(now()) @map("created_at")

  report          ProcedureReport  @relation("ProcedureReportVersions", fields: [reportId], references: [id])
  activeForReport ProcedureReport? @relation("ProcedureReportActiveVersion")

  @@unique([reportId, versionNumber])
  @@map("procedure_report_version")
}

model ProcedureCriticalIncident {
  id             String    @id @default(uuid())
  sessionId      String    @map("session_id")
  description    String
  detectedAt     DateTime  @map("detected_at")
  detectedBy     String    @map("detected_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")
  resolution     String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  session ProcedureSession @relation(fields: [sessionId], references: [id])

  @@map("procedure_critical_incident")
}

enum BloodComponentType {
  PACKED_RBC
  WHOLE_BLOOD
  PLATELETS
  FRESH_FROZEN_PLASMA
  CRYOPRECIPITATE
  GRANULOCYTES
}

enum BloodRequestStatus {
  REQUESTED
  APPROVED
  CROSSMATCH_PENDING
  CROSSMATCH_COMPLETE
  ALLOCATED
  ISSUED
  TRANSFUSION_STARTED
  TRANSFUSION_COMPLETED
  CANCELLED
}

enum CrossmatchStatus {
  PENDING
  COMPATIBLE
  INCOMPATIBLE
  EXPIRED
}

enum TransfusionStatus {
  NOT_STARTED
  STARTED
  PAUSED
  COMPLETED
  STOPPED
}

enum ReactionSeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum BloodUnitStatus {
  AVAILABLE
  RESERVED
  ISSUED
  TRANSFUSED
  DISCARDED
  QUARANTINED
}

enum AllocationPolicy {
  FIFO
  FEFO
  MANUAL_OVERRIDE
}

enum TransfusionReactionOutcome {
  RESOLVED
  ESCALATED
  FATAL
}

enum TransfusionReactionStatus {
  RECORDED
  CLINICAL_REVIEW
  RESOLVED
  ESCALATED
}

model HospitalBloodBankPolicy {
  id                             String             @id @default(uuid())
  hospitalId                     String
  hospital                       HospitalsMaster    @relation(fields: [hospitalId], references: [id])
  componentType                  BloodComponentType
  defaultCrossmatchValidityHours Int
  maximumReservationHours        Int
  emergencyReleaseEnabled        Boolean            @default(true)
  doubleVerificationRequired     Boolean            @default(true)
  bedsideVerificationRequired    Boolean            @default(true)
  allocationPolicy               AllocationPolicy   @default(FIFO)

  @@unique([hospitalId, componentType])
}

model BloodBankExecution {
  id          String             @id @default(uuid())
  orderId     String             @unique
  order       Order              @relation(fields: [orderId], references: [id])
  hospitalId  String
  hospital    HospitalsMaster    @relation(fields: [hospitalId], references: [id])
  patientId   String
  patient     Patient            @relation(fields: [patientId], references: [id])
  status      BloodRequestStatus @default(REQUESTED)
  requestedAt DateTime           @default(now())

  items     BloodBankExecutionItem[]
  audits    BloodBankAudit[]
  overrides EmergencyBloodOverride[]
}

model BloodBankExecutionItem {
  id                String             @id @default(uuid())
  executionId       String
  execution         BloodBankExecution @relation(fields: [executionId], references: [id])
  orderItemId       String             @unique
  orderItem         OrderItem          @relation(fields: [orderItemId], references: [id])
  componentType     BloodComponentType
  requestedVolumeMl Float?
  requestedUnits    Int
  status            BloodRequestStatus @default(REQUESTED)

  crossmatches Crossmatch[]
  allocations  BloodAllocation[]
  issues       BloodIssue[]
}

model EmergencyBloodOverride {
  id                    String             @id @default(uuid())
  executionId           String
  execution             BloodBankExecution @relation(fields: [executionId], references: [id])
  reason                String
  authorizedBy          String
  approvedAt            DateTime           @default(now())
  overrideType          String             @default("UNCROSSMATCHED_O_NEGATIVE")
  clinicalJustification String
}

model BloodUnit {
  id                    String             @id @default(uuid())
  hospitalId            String
  hospital              HospitalsMaster    @relation(fields: [hospitalId], references: [id])
  isbt128DonationNumber String             @unique
  componentCode         String
  componentType         BloodComponentType
  bloodGroupABO         String
  bloodGroupRh          String
  collectionDate        DateTime
  expiryDate            DateTime
  currentStatus         BloodUnitStatus    @default(AVAILABLE)

  crossmatches Crossmatch[]
  allocations  BloodAllocation[]
  issues       BloodIssue[]
}

model Crossmatch {
  id              String                 @id @default(uuid())
  executionItemId String
  executionItem   BloodBankExecutionItem @relation(fields: [executionItemId], references: [id])
  bloodUnitId     String
  bloodUnit       BloodUnit              @relation(fields: [bloodUnitId], references: [id])
  status          CrossmatchStatus       @default(PENDING)
  technicianId    String
  performedAt     DateTime?
  expiryAt        DateTime?

  @@unique([executionItemId, bloodUnitId])
}

model BloodAllocation {
  id              String                 @id @default(uuid())
  executionItemId String
  executionItem   BloodBankExecutionItem @relation(fields: [executionItemId], references: [id])
  bloodUnitId     String
  bloodUnit       BloodUnit              @relation(fields: [bloodUnitId], references: [id])
  allocatedAt     DateTime               @default(now())
  allocatedBy     String
  expiresAt       DateTime?
  active          Boolean                @default(true)

  @@unique([executionItemId, bloodUnitId])
}

model BloodIssue {
  id              String                 @id @default(uuid())
  executionItemId String
  executionItem   BloodBankExecutionItem @relation(fields: [executionItemId], references: [id])
  bloodUnitId     String
  bloodUnit       BloodUnit              @relation(fields: [bloodUnitId], references: [id])
  issuedAt        DateTime               @default(now())
  issuedBy        String
  issuedTo        String
  active          Boolean                @default(true)

  transfusionEpisode TransfusionEpisode?

  @@unique([executionItemId, bloodUnitId])
}

model BedsideVerification {
  id                   String             @id @default(uuid())
  transfusionEpisodeId String             @unique
  transfusionEpisode   TransfusionEpisode @relation(fields: [transfusionEpisodeId], references: [id])
  patientVerified      Boolean            @default(false)
  unitVerified         Boolean            @default(false)
  componentVerified    Boolean            @default(false)
  performedBy          String
  performedAt          DateTime           @default(now())
}

model TransfusionEpisode {
  id                   String            @id @default(uuid())
  issueId              String            @unique
  issue                BloodIssue        @relation(fields: [issueId], references: [id])
  patientId            String
  patient              Patient           @relation(fields: [patientId], references: [id])
  status               TransfusionStatus @default(NOT_STARTED)
  startedAt            DateTime?
  stoppedAt            DateTime?
  administeringNurseId String?

  verification BedsideVerification?
  observations TransfusionObservation[]
  reaction     TransfusionReaction?
}

model TransfusionObservation {
  id               String             @id @default(uuid())
  episodeId        String
  episode          TransfusionEpisode @relation(fields: [episodeId], references: [id])
  observationTime  DateTime           @default(now())
  observerId       String
  stage            String // BASELINE, 15_MIN, HOURLY, COMPLETION
  temperature      Float?
  pulse            Int?
  bloodPressure    String? // "120/80"
  respiratoryRate  Int?
  oxygenSaturation Int?
}

model TransfusionReaction {
  id                     String                      @id @default(uuid())
  episodeId              String                      @unique
  episode                TransfusionEpisode          @relation(fields: [episodeId], references: [id])
  status                 TransfusionReactionStatus   @default(RECORDED)
  severity               ReactionSeverity
  suspectedCause         String?
  symptoms               String
  investigationRequested Boolean                     @default(false)
  management             String?
  outcome                TransfusionReactionOutcome?
  recordedAt             DateTime                    @default(now())
  recordedBy             String
  resolutionTime         DateTime?
}

model BloodBankAudit {
  id          String             @id @default(uuid())
  executionId String
  execution   BloodBankExecution @relation(fields: [executionId], references: [id])
  action      String
  performedBy String
  timestamp   DateTime           @default(now())
  details     Json
}

// ============================================================
// PHASE 5B.6 � REFERRAL & CARE COORDINATION EXECUTION ENGINE
// ============================================================

enum ReferralType {
  INTERNAL_SAME_DEPARTMENT
  INTERNAL_CROSS_DEPARTMENT
  INTERNAL_CROSS_HOSPITAL
  EXTERNAL_HOSPITAL
  SECOND_OPINION
  FOLLOW_UP_REFERRAL
  TUMOR_BOARD
}

enum ReferralOutcome {
  ADVICE_ONLY
  TRANSFER_ACCEPTED
  TRANSFER_DECLINED
  FURTHER_FOLLOW_UP_REQUIRED
  CLOSED
}

enum CommunicationStatus {
  SENT
  DELIVERED
  OPENED
  ACKNOWLEDGED
  FAILED
}

enum CareTransferStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
  REVOKED
}

model ReferralExecution {
  id                 String           @id @default(uuid())
  orderId            String           @unique @map("order_id")
  order              Order            @relation(fields: [orderId], references: [id])
  hospitalId         String           @map("hospital_id")
  patientId          String           @map("patient_id")
  patient            Patient          @relation(fields: [patientId], references: [id])
  referralType       ReferralType     @map("referral_type")
  status             ReferralStatus   @default(DRAFT) @map("status")
  priority           ReferralPriority @default(ROUTINE) @map("priority")
  clinicalSummary    String           @map("clinical_summary")
  reasonForReferral  String           @map("reason_for_referral")
  requestingDoctorId String           @map("requesting_doctor_id")
  requestedAt        DateTime         @default(now()) @map("requested_at")
  sentAt             DateTime?        @map("sent_at")
  completedAt        DateTime?        @map("completed_at")
  cancelledAt        DateTime?        @map("cancelled_at")
  cancellationReason String?          @map("cancellation_reason")
  expiresAt          DateTime?        @map("expires_at")

  // FHIR Preparation Fields (reserved � not yet integrated)
  fhirServiceRequestId String? @map("fhir_service_request_id")
  fhirTaskId           String? @map("fhir_task_id")

  items          ReferralExecutionItem[]
  communications ReferralCommunication[]
  careTransfer   CareTransfer?
  auditLog       ReferralAudit[]

  @@map("referral_executions")
}

model ReferralExecutionItem {
  id             String            @id @default(uuid())
  executionId    String            @map("execution_id")
  execution      ReferralExecution @relation(fields: [executionId], references: [id])
  orderItemId    String            @unique @map("order_item_id")
  orderItem      OrderItem         @relation(fields: [orderItemId], references: [id])
  status         ReferralStatus    @default(DRAFT)
  specialtyCode  String?           @map("specialty_code")
  departmentCode String?           @map("department_code")

  recipients    ReferralRecipient[]
  appointments  ReferralAppointment[]
  responses     ReferralResponse[]
  outcomeReport ReferralOutcomeReport?

  @@map("referral_execution_items")
}

model ReferralRecipient {
  id                  String                @id @default(uuid())
  executionItemId     String                @map("execution_item_id")
  executionItem       ReferralExecutionItem @relation(fields: [executionItemId], references: [id])
  recipientType       String                @map("recipient_type") // DOCTOR, DEPARTMENT, HOSPITAL, TEAM
  recipientId         String?               @map("recipient_id") // Internal doctor/dept ID
  recipientName       String                @map("recipient_name")
  recipientHospitalId String?               @map("recipient_hospital_id")
  recipientSpecialty  String?               @map("recipient_specialty")

  // FHIR Preparation Fields
  fhirPractitionerId String? @map("fhir_practitioner_id")
  fhirOrganizationId String? @map("fhir_organization_id")
  fhirEndpointId     String? @map("fhir_endpoint_id")

  acknowledgedAt DateTime? @map("acknowledged_at")
  acceptedAt     DateTime? @map("accepted_at")
  declinedAt     DateTime? @map("declined_at")
  declineReason  String?   @map("decline_reason")
  addedAt        DateTime  @default(now()) @map("added_at")

  @@map("referral_recipients")
}

model ReferralCommunication {
  id               String              @id @default(uuid())
  executionId      String              @map("execution_id")
  execution        ReferralExecution   @relation(fields: [executionId], references: [id])
  channel          String // EMAIL, SMS, WHATSAPP, IN_APP, FAX
  recipientAddress String              @map("recipient_address")
  subject          String?
  bodyHash         String              @map("body_hash") // SHA-256 of message body � no PHI stored
  status           CommunicationStatus @default(SENT)
  sentAt           DateTime            @default(now()) @map("sent_at")
  deliveredAt      DateTime?           @map("delivered_at")
  openedAt         DateTime?           @map("opened_at")
  acknowledgedAt   DateTime?           @map("acknowledged_at")
  isReminder       Boolean             @default(false) @map("is_reminder")
  isEscalation     Boolean             @default(false) @map("is_escalation")
  sentBy           String              @map("sent_by")

  @@map("referral_communications")
}

model ReferralAppointment {
  id                  String                @id @default(uuid())
  executionItemId     String                @map("execution_item_id")
  executionItem       ReferralExecutionItem @relation(fields: [executionItemId], references: [id])
  scheduledAt         DateTime              @map("scheduled_at")
  scheduledBy         String                @map("scheduled_by")
  locationDescription String?               @map("location_description")
  appointmentType     String                @default("OUTPATIENT") @map("appointment_type")
  status              String                @default("SCHEDULED")
  confirmedAt         DateTime?             @map("confirmed_at")
  attendedAt          DateTime?             @map("attended_at")
  cancelledAt         DateTime?             @map("cancelled_at")
  notes               String?

  @@map("referral_appointments")
}

model ReferralResponse {
  id              String                @id @default(uuid())
  executionItemId String                @map("execution_item_id")
  executionItem   ReferralExecutionItem @relation(fields: [executionItemId], references: [id])
  respondedBy     String                @map("responded_by")
  respondedAt     DateTime              @default(now()) @map("responded_at")
  decision        String // ACCEPTED, DECLINED
  declineReason   String?               @map("decline_reason")
  clinicalNotes   String?               @map("clinical_notes")
  isAdviceOnly    Boolean               @default(false) @map("is_advice_only")

  @@map("referral_responses")
}

model CareTransfer {
  id                    String             @id @default(uuid())
  executionId           String             @unique @map("execution_id")
  execution             ReferralExecution  @relation(fields: [executionId], references: [id])
  fromDoctorId          String             @map("from_doctor_id")
  toDoctorId            String             @map("to_doctor_id")
  patientId             String             @map("patient_id")
  patient               Patient            @relation(fields: [patientId], references: [id])
  status                CareTransferStatus @default(REQUESTED)
  requestedAt           DateTime           @default(now()) @map("requested_at")
  requestedBy           String             @map("requested_by")
  clinicalJustification String             @map("clinical_justification")
  acceptedAt            DateTime?          @map("accepted_at")
  acceptedBy            String?            @map("accepted_by")
  rejectedAt            DateTime?          @map("rejected_at")
  rejectedBy            String?            @map("rejected_by")
  rejectionReason       String?            @map("rejection_reason")
  completedAt           DateTime?          @map("completed_at")
  relationshipId        String?            @map("relationship_id") // FK to DoctorPatientRelationship after transfer

  @@map("care_transfers")
}

model ReferralOutcomeReport {
  id                    String                @id @default(uuid())
  executionItemId       String                @unique @map("execution_item_id")
  executionItem         ReferralExecutionItem @relation(fields: [executionItemId], references: [id])
  outcome               ReferralOutcome
  reportedBy            String                @map("reported_by")
  reportedAt            DateTime              @default(now()) @map("reported_at")
  clinicalFinding       String?               @map("clinical_finding")
  recommendationSummary String?               @map("recommendation_summary")
  followUpRequired      Boolean               @default(false) @map("follow_up_required")
  followUpDays          Int?                  @map("follow_up_days")
  closedAt              DateTime?             @map("closed_at")

  @@map("referral_outcome_reports")
}

model ReferralAudit {
  id          String            @id @default(uuid())
  executionId String            @map("execution_id")
  execution   ReferralExecution @relation(fields: [executionId], references: [id])
  action      String
  performedBy String            @map("performed_by")
  timestamp   DateTime          @default(now())
  details     Json

  @@map("referral_audits")
}

// ===================== PLATFORM IDENTITY =====================
enum AdminRole {
  PLATFORM_ADMIN
  NETWORK_ADMIN
  HOSPITAL_ADMIN
}

model PlatformAdmin {
  id          String         @id @default(uuid())
  email       String         @unique
  name        String
  role        AdminRole      @default(PLATFORM_ADMIN)
  mfaEnabled  Boolean        @default(false)
  status      String         @default("ACTIVE") // ACTIVE | DISABLED
  lastLoginAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  networkId   String? // set when role = NETWORK_ADMIN
  permissions Json?          @default("{}")
  sessions    AdminSession[]
  apiTokens   ApiToken[]

  @@map("platform_admins")
}

model AdminSession {
  id         String        @id @default(uuid())
  adminId    String        @map("admin_id")
  ip         String?
  userAgent  String?       @map("user_agent")
  deviceHash String?       @map("device_hash")
  expiresAt  DateTime      @map("expires_at")
  createdAt  DateTime      @default(now())
  revokedAt  DateTime?     @map("revoked_at")
  admin      PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model ApiToken {
  id          String        @id @default(uuid())
  adminId     String        @map("admin_id")
  name        String
  hashedToken String        @map("hashed_token")
  scopes      String[] // e.g. ["hospital:read","event:replay"]
  lastUsedAt  DateTime?     @map("last_used_at")
  expiresAt   DateTime?     @map("expires_at")
  createdAt   DateTime      @default(now())
  revokedAt   DateTime?     @map("revoked_at")
  admin       PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

// ===================== NETWORKS / ORGS =====================
model Network {
  id           String                      @id @default(uuid())
  name         String
  parentOrgId  String?                     @map("parent_org_id")
  region       String?
  ownerAdminId String?                     @map("owner_admin_id")
  createdAt    DateTime                    @default(now())
  hospitals    HospitalNetworkMembership[]

  @@map("networks")
}

// Link table: hospital <-> network membership
model HospitalNetworkMembership {
  id         String          @id @default(uuid())
  hospitalId String          @map("hospital_id")
  networkId  String          @map("network_id")
  role       String          @default("MEMBER") // MEMBER | HUB | SPOKE
  joinedAt   DateTime        @default(now())
  hospital   HospitalsMaster @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  network    Network         @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, networkId])
  @@map("hospital_network_membership")
}

// ===================== PLATFORM RBAC =====================
// Orthogonal to hospital-scoped RolePermission. Governs platform/network scope.
model PlatformPermission {
  id         String  @id @default(uuid())
  adminId    String  @map("admin_id")
  scope      String // PLATFORM | NETWORK | HOSPITAL
  resource   String // hospitals | subscriptions | flags | integrations ...
  action     String // read | write | approve | suspend
  allowed    Boolean @default(true)
  conditions Json?   @default("{}")

  @@unique([adminId, scope, resource, action])
  @@map("platform_permissions")
}

// ===================== FEATURE FLAGS =====================
model FeatureFlag {
  id              String               @id @default(uuid())
  key             String               @unique // e.g. "ai_scribe", "abdm_v2"
  name            String
  description     String?
  enabled         Boolean              @default(false)
  rolloutType     String               @default("GLOBAL") // GLOBAL | CANARY | BETA | OFF
  rolloutPct      Int                  @default(0) @map("rollout_pct")
  betaHospitalIds String[]             @map("beta_hospital_ids")
  createdBy       String               @map("created_by")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  history         FeatureFlagHistory[]

  @@map("feature_flags")
}

model FeatureFlagHistory {
  id        String      @id @default(uuid())
  flagId    String      @map("flag_id")
  changedBy String      @map("changed_by")
  prev      Json?
  next      Json?
  createdAt DateTime    @default(now())
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@map("feature_flag_history")
}

// ===================== SUBSCRIPTIONS / SaaS =====================
model Plan {
  id           String         @id @default(uuid())
  name         String
  code         String         @unique // STARTER | GROWTH | ENTERPRISE
  priceMonthly Decimal        @map("price_monthly")
  priceAnnual  Decimal        @map("price_annual")
  quota        Json // { beds, doctors, storageGb, aiCredits }
  features     String[]
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now())
  subs         Subscription[]

  @@map("plans")
}

model Subscription {
  id          String            @id @default(uuid())
  hospitalId  String            @unique @map("hospital_id")
  planId      String            @map("plan_id")
  status      String            @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  startDate   DateTime          @map("start_date")
  endDate     DateTime?         @map("end_due")
  trialEndsAt DateTime?         @map("trial_ends_at")
  seatsUsed   Int               @default(0) @map("seats_used")
  usageMeters Json?             @map("usage_meters") // { storageGb, aiCredits, apiCalls }
  createdAt   DateTime          @default(now())
  hospital    HospitalsMaster   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  plan        Plan              @relation(fields: [planId], references: [id])
  invoices    PlatformInvoice[]

  @@map("subscriptions")
}

model PlatformInvoice {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  number         String       @unique
  amount         Decimal
  tax            Decimal      @default(0)
  status         String       @default("UNPAID") // UNPAID | PAID | REFUNDED | FAILED
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  paidAt         DateTime?    @map("paid_at")
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("platform_invoices")
}

// ===================== WEBHOOK / EVENT REGISTRY (platform) =====================
model WebhookSubscription {
  id          String            @id @default(uuid())
  name        String
  hospitalId  String?           @map("hospital_id") // NULL = platform-wide
  url         String
  secret      String
  eventTypes  String[]          @map("event_types")
  isActive    Boolean           @default(true) @map("is_active")
  retryPolicy Json?             @map("retry_policy")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deliveries  WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  eventId        String?             @map("event_id")
  statusCode     Int?                @map("status_code")
  attempts       Int                 @default(0)
  nextRetryAt    DateTime?           @map("next_retry_at")
  lastError      String?             @map("last_error")
  deliveredAt    DateTime?           @map("delivered_at")
  createdAt      DateTime            @default(now())
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

// ===================== CONSENT / COMPLIANCE =====================
model ConsentRecord {
  id          String    @id @default(uuid())
  hospitalId  String    @map("hospital_id")
  patientId   String    @map("patient_id")
  purpose     String // CONSULT | RESEARCH | SHARING | MARKETING
  status      String    @default("GRANTED") // GRANTED | REVOKED | EXPIRED
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  expiresAt   DateTime? @map("expires_at")
  artifactUrl String?   @map("artifact_url") // signed consent PDF

  @@index([hospitalId, patientId])
  @@map("consent_records")
}

model DataExportRequest {
  id          String   @id @default(uuid())
  hospitalId  String?  @map("hospital_id")
  requestedBy String   @map("requested_by")
  type        String // ERASURE | EXPORT | BREACH_REPORT
  status      String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  filters     Json?
  resultUrl   String?  @map("result_url")
  createdAt   DateTime @default(now())

  @@map("data_export_requests")
}

// ===================== MASTER DATA =====================
model MasterCode {
  id         String  @id @default(uuid())
  system     String // ICD10 | LOINC | SNOMED | MEDICINE | CITY | STATE | INSURER
  code       String
  label      String
  parentCode String? @map("parent_code")
  extra      Json?

  @@unique([system, code])
  @@index([system])
  @@map("master_codes")
}

// ===================== UNIVERSAL SEARCH INDEX =====================
model SearchEntity {
  id          String   @id @default(uuid())
  kind        String // hospital | doctor | patient | invoice | prescription | audit | event | report | user | config
  refId       String   @map("ref_id")
  hospitalId  String?  @map("hospital_id")
  tenantScope String   @default("PLATFORM") // PLATFORM | NETWORK | HOSPITAL
  title       String
  payload     Json?
  updatedAt   DateTime @updatedAt

  @@index([kind, hospitalId])
  @@index([title])
  @@map("search_entities")
}

model PlatformTimelineEvent {
  id            String   @id @default(uuid())
  entityType    String   @map("entity_type") // e.g., "HOSPITAL", "NETWORK"
  entityId      String   @map("entity_id")
  eventType     String   @map("event_type") // e.g., "HospitalDocumentsUploaded"
  previousState String?  @map("previous_state")
  newState      String   @map("new_state")
  actorId       String?  @map("actor_id")
  actorRole     String?  @map("actor_role")
  correlationId String?  @map("correlation_id")
  workflowId    String?  @map("workflow_id")
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
  @@map("platform_timeline_events")
}

model HospitalHealthSnapshot {
  id                  String   @id @default(uuid())
  hospitalId          String   @map("hospital_id")
  timestamp           DateTime @default(now())
  overallScore        Int      @map("overall_score")
  clinicalScore       Int      @map("clinical_score")
  infrastructureScore Int      @map("infrastructure_score")
  securityScore       Int      @map("security_score")
  complianceScore     Int      @map("compliance_score")
  financialScore      Int      @map("financial_score")
  performanceScore    Int      @map("performance_score")

  @@index([hospitalId, timestamp])
  @@map("hospital_health_snapshots")
}

model WorkflowMetric {
  id                 String    @id @default(uuid())
  workflowId         String    @map("workflow_id")
  instanceId         String    @map("instance_id")
  entityType         String    @map("entity_type")
  entityId           String    @map("entity_id")
  startedAt          DateTime  @map("started_at")
  completedAt        DateTime? @map("completed_at")
  durationMs         Int?      @map("duration_ms")
  waitTimeMs         Int?      @map("wait_time_ms")
  executionTimeMs    Int?      @map("execution_time_ms")
  retryCount         Int       @default(0) @map("retry_count")
  failureCount       Int       @default(0) @map("failure_count")
  slaBreached        Boolean   @default(false) @map("sla_breached")
  manualIntervention Boolean   @default(false) @map("manual_intervention")
  finalStatus        String    @map("final_status") // e.g. COMPLETED, FAILED, DEAD_LETTER

  @@index([workflowId, entityId])
  @@index([completedAt])
  @@map("workflow_metrics")
}

model Incident {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  severity           String // e.g. CRITICAL, HIGH, MEDIUM, LOW
  status             String    @default("DETECTED") // DETECTED, ASSIGNED, ACKNOWLEDGED, MITIGATED, RESOLVED, POSTMORTEM
  detectedAt         DateTime  @default(now()) @map("detected_at")
  resolvedAt         DateTime? @map("resolved_at")
  assignedTo         String?   @map("assigned_to")
  component          String? // e.g. REDIS, WEBHOOK, ABDM
  hospitalId         String?   @map("hospital_id")
  workflowInstanceId String?   @map("workflow_instance_id")

  @@index([status, detectedAt])
  @@map("incidents")
}

model PlatformRecommendation {
  id          String   @id @default(uuid())
  hospitalId  String?  @map("hospital_id")
  networkId   String?  @map("network_id")
  type        String // e.g. ENABLE_QUEUE_OPTIMIZATION, RENEW_LICENSE, STORAGE_WARNING
  message     String
  actionUrl   String?  @map("action_url")
  priority    String   @default("LOW") // HIGH, MEDIUM, LOW
  isDismissed Boolean  @default(false) @map("is_dismissed")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([hospitalId, isDismissed])
  @@map("platform_recommendations")
}

// ===================== CAPABILITY REGISTRY =====================

model CapabilityRegistry {
  id                    String   @id @default(uuid())
  key                   String   @unique // e.g., "emr_core", "abdm_integration", "pacs_viewer"
  name                  String
  category              String // CLINICAL | BILLING | INTEGRATION | AI | COMMUNICATION | IDENTITY | ANALYTICS
  description           String?
  version               String   @default("1.0.0")
  dependencies          String[] @default([]) // Array of capability keys required for this to function
  conflicts             String[] @default([]) // Array of capability keys this conflicts with
  visibility            String   @default("PUBLIC") // PUBLIC | INTERNAL | BETA
  defaultEnabled        Boolean  @default(false)
  requiresConfiguration Boolean  @default(false)
  deprecated            Boolean  @default(false)
  createdAt             DateTime @default(now())

  hospitalCapabilities HospitalCapability[]

  @@map("capability_registry")
}

model HospitalCapability {
  id                String    @id @default(uuid())
  hospitalId        String    @map("hospital_id")
  capabilityKey     String    @map("capability_key")
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING_CONFIG
  grantedBy         String // SUBSCRIPTION | FEATURE_FLAG | MANUAL_GRANT
  referenceId       String? // ID of the plan, flag, or admin who granted it
  effectiveFrom     DateTime  @default(now()) @map("effective_from")
  expiresAt         DateTime? @map("expires_at")
  sourcePriority    Int       @default(0) // Higher number = higher precedence
  reason            String?
  lastEvaluated     DateTime  @default(now()) @map("last_evaluated")
  configurationHash String?   @map("configuration_hash")
  config            Json? // Configuration for this capability
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  hospital   HospitalsMaster    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  capability CapabilityRegistry @relation(fields: [capabilityKey], references: [key], onDelete: Cascade)

  @@unique([hospitalId, capabilityKey])
  @@map("hospital_capabilities")
}

// ===================== AI GOVERNANCE & INTELLIGENCE =====================

model AiModelRegistry {
  id              String   @id @default(uuid())
  key             String   @unique // e.g. "gpt-4-turbo"
  provider        String
  purpose         String // e.g. "CLASSIFICATION", "SUMMARIZATION", "ANALYSIS"
  version         String
  contextWindow   Int      @map("context_window")
  maxTokens       Int      @map("max_tokens")
  latencyMsAvg    Int      @default(0) @map("latency_ms_avg")
  costPer1k       Float    @default(0) @map("cost_per_1k")
  supportsVision  Boolean  @default(false) @map("supports_vision")
  supportsJson    Boolean  @default(false) @map("supports_json")
  supportsTools   Boolean  @default(false) @map("supports_tools")
  status          String   @default("ACTIVE") // ACTIVE | DEPRECATED | FALLBACK
  fallbackModelId String?  @map("fallback_model_id")
  evaluationScore Float?   @map("evaluation_score")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_model_registry")
}

model AiPromptRegistry {
  id              String    @id @default(uuid())
  key             String    @unique
  version         String
  description     String?
  content         String // The actual prompt template
  variables       String[]  @default([]) // e.g. ["incident_title", "logs"]
  expectedSchema  Json?     @map("expected_schema")
  evaluationScore Float?    @map("evaluation_score")
  lastTestedAt    DateTime? @map("last_tested_at")
  rollbackVersion String?   @map("rollback_version")
  owner           String // e.g. "platform_engineering"
  status          String    @default("ACTIVE")
  tags            String[]  @default([])
  approvedBy      String?   @map("approved_by")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("ai_prompt_registry")
}

model AiPolicy {
  id            String   @id @default(uuid())
  key           String   @unique
  name          String
  description   String?
  riskLevel     Int // 1 (Auto), 2 (Approval), 3 (Never)
  actionType    String // e.g. "RESTART_WORKER", "SUSPEND_HOSPITAL"
  conditions    Json? // Conditions under which this policy applies
  requiresHuman Boolean  @default(false) @map("requires_human")
  region        String? // e.g. "IN-MH" for regional policies
  tenantId      String? // Specific hospital override
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("ai_policies")
}

model AiActionLog {
  id            String  @id @default(uuid())
  traceId       String  @unique @map("trace_id")
  incidentId    String? @map("incident_id")
  agent         String // e.g. "OperationsAnalyzer"
  modelId       String  @map("model_id")
  modelVersion  String  @map("model_version")
  promptId      String  @map("prompt_id")
  promptVersion String  @map("prompt_version")

  inputHash  String @map("input_hash")
  outputHash String @map("output_hash")

  confidence Float
  riskLevel  Int     @map("risk_level")
  decision   String
  policyId   String? @map("policy_id")

  executionMode String  @default("RECOMMENDATION") // AUTONOMOUS | HUMAN_APPROVAL | RECOMMENDATION
  approvedBy    String? @map("approved_by")
  executed      Boolean @default(false)
  rollbackId    String? @map("rollback_id")

  latencyMs  Int   @map("latency_ms")
  tokenUsage Int   @map("token_usage")
  costUsd    Float @map("cost_usd")

  feedback     String?
  humanOutcome String? @map("human_outcome") // e.g. "ACCEPTED", "REJECTED", "MODIFIED"

  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([incidentId])
  @@index([riskLevel, executionMode])
  @@map("ai_action_logs")
}

// ===================== REPORTING & SEMANTIC INTELLIGENCE =====================

model SemanticEntity {
  id            String   @id @default(uuid())
  entityName    String   @unique // e.g. "Hospital", "Invoice", "Incident"
  tableName     String   @map("table_name") // e.g. "hospitals_master"
  description   String?
  attributes    Json // Array of field definitions (name, type, dbColumn)
  relationships Json // Array of relations to other entities
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("semantic_entities")
}

model ReportDefinition {
  id            String   @id @default(uuid())
  title         String
  description   String?
  semanticQuery Json     @map("semantic_query") // Structured query logic using SemanticEntities
  sqlQuery      String?  @map("sql_query") // Generated raw SQL, cached for execution
  schedule      String? // Cron expression
  createdBy     String   @map("created_by")
  audienceRole  String   @default("PLATFORM_ADMIN") @map("audience_role") // CEO, COO, CTO
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("report_definitions")
}

model ReportExecutionLog {
  id           String   @id @default(uuid())
  reportId     String   @map("report_id")
  executedAt   DateTime @default(now()) @map("executed_at")
  latencyMs    Int      @map("latency_ms")
  status       String // SUCCESS | FAILED
  errorMessage String?  @map("error_message")
  resultRowCnt Int      @default(0) @map("result_row_cnt")

  @@index([reportId])
  @@map("report_execution_logs")
}

// ===================== PREDICTIVE INTELLIGENCE =====================

model FeatureRegistry {
  id               String   @id @default(uuid())
  key              String   @unique // e.g. "hospital_daily_revenue"
  domain           String // OPERATIONAL | CLINICAL | FINANCIAL | BUSINESS
  description      String?
  calculation      String // e.g. "SUM(amount) from Invoices WHERE..."
  refreshFrequency String // e.g. "HOURLY", "DAILY"
  sourceTables     String[] @map("source_tables")
  owner            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("feature_registry")
}

model PredictiveModel {
  id            String    @id @default(uuid())
  domain        String // OPERATIONAL | CLINICAL | FINANCIAL | BUSINESS
  name          String
  version       String
  description   String?
  owner         String?
  featureSet    Json?     @map("feature_set") // Array of FeatureRegistry keys
  evaluation    Json? // Metrics like precision, recall, MAE
  accuracy      Float?
  lastTrainedAt DateTime? @map("last_trained_at")
  deployedAt    DateTime? @map("deployed_at")
  status        String    @default("ACTIVE") // ACTIVE | SHADOW | DEPRECATED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([name, version])
  @@map("predictive_models")
}

model PredictionInsight {
  id                 String    @id @default(uuid())
  modelId            String    @map("model_id")
  modelVersion       String    @map("model_version")
  entityType         String // e.g. "HOSPITAL", "QUEUE", "WORKFLOW"
  entityId           String    @map("entity_id")
  insight            String // e.g. "82% probability of SLA breach in 24h"
  probability        Float
  severity           String // LOW | MEDIUM | HIGH | CRITICAL
  recommendationType String?   @map("recommendation_type") // e.g. "SCALE_WORKERS"
  recommendation     String?
  expiresAt          DateTime? @map("expires_at")
  acknowledged       Boolean   @default(false)
  resolved           Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([expiresAt])
  @@map("prediction_insights")
}

// ===================== KNOWLEDGE LAYER (SEMANTIC GRAPH) =====================

model KnowledgeGraphNode {
  id            String   @id @default(uuid())
  nodeType      String   @map("node_type") // HOSPITAL, DOCTOR, INCIDENT, WORKFLOW, POLICY
  referenceId   String   @map("reference_id") // UUID of the actual operational record
  summary       Json // Semantic snapshot
  embeddingId   String?  @map("embedding_id") // Link to vector DB if needed
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")
  sourceVersion Int      @default(1) @map("source_version")
  createdAt     DateTime @default(now())

  @@unique([nodeType, referenceId])
  @@map("kg_nodes")
}

model KnowledgeGraphEdge {
  id            String   @id @default(uuid())
  sourceNodeId  String   @map("source_node_id")
  targetNodeId  String   @map("target_node_id")
  relation      String // e.g. "EMPLOYS", "RESOLVED_BY", "DEPENDS_ON"
  direction     String   @default("DIRECTED") // DIRECTED | BIDIRECTIONAL
  strength      Float    @default(1.0)
  confidence    Float    @default(1.0)
  derivedFrom   String?  @map("derived_from") // e.g. "AI_ANALYSIS", "EXPLICIT_RELATION"
  lastValidated DateTime @default(now()) @map("last_validated")
  createdAt     DateTime @default(now())

  @@unique([sourceNodeId, targetNodeId, relation])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@map("kg_edges")
}

// ===================== DECISION ENGINE & COPILOT =====================

model DecisionRule {
  id              String   @id @default(uuid())
  name            String
  domain          String // OPERATIONAL | CLINICAL | FINANCIAL
  condition       Json
  actionType      String   @map("action_type")
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  cooldownHours   Int      @default(24) @map("cooldown_hours")
  owner           String?
  version         String   @default("1.0.0")
  rollbackVersion String?  @map("rollback_version")
  createdAt       DateTime @default(now())

  @@map("decision_rules")
}

