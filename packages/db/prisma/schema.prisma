  lamaEpisodes    LamaEpisode[]
  absenceEpisodes AbsenceEpisode[]
  departureRecord PhysicalDepartureRecord?

  hospital        HospitalsMaster @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
