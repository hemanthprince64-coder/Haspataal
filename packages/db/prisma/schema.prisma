  @@index([encounterId, status])
  @@index([patientId])
  @@index([patientId, status])
  @@index([hospitalId])
  @@index([hospitalId, status])
  @@index([type, status])
  @@index([priority, status])
  @@index([status])
  @@map("clinical_orders")
}

enum ClinicalTaskStatus {
