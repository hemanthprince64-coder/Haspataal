enum ClinicalStatus {
  ADMITTED
  DISCHARGE_CLINICALLY_DECIDED
}

enum DischargeProcessStatus {
  NOT_INITIATED
  CLEARANCES_PENDING
  READY_FOR_DEPARTURE
}

enum PhysicalPresenceStatus {
  PRESENT
  ABSENCE_SUSPECTED
  DEPARTED_STANDARD
  DEPARTED_LAMA
  DEPARTED_WITHOUT_NOTICE
}

enum LegacyDepartureClassification {
  NONE
  LEGACY_DISCHARGED_WITHOUT_AUTHORITATIVE_DEPARTURE_EVIDENCE
}

enum DeparturePathway {
  STANDARD
  LAMA
  WITHOUT_NOTICE
  LEGACY_UNCLEAR
}

enum EvidenceType {
  MANUAL_ENTRY
  SYSTEM_OVERRIDE
  SECURITY_GATE
  LEGACY_BACKFILL
}

enum LamaStatus {
  INITIATED
  DOCUMENTATION_IN_PROGRESS
  DOCUMENTED
  WITHDRAWN
}

enum AbsenceStatus {
  SUSPECTED
  INVESTIGATION_IN_PROGRESS
  RESOLVED_RETURNED
  CONFIRMED_DEPARTED
}

model LamaEpisode {
